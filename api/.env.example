# Cubiq-Website und API – Konfiguration. Kopieren nach .env und ausfüllen. .env NIE committen.
# Leere Werte = Standard. Erklärung aller Schlüssel: README.md (Abschnitt „.env-Schlüssel“).

# Cloudflare-Tunnel-Token (Zero Trust → Networks → Tunnels → Tunnel → Docker-Anleitung:
# der lange Wert hinter --token). Nur cloudflared bekommt ihn.
TUNNEL_TOKEN=

# Pflicht: mindestens 32 zufällige Zeichen, z. B.  openssl rand -base64 48
# Schlüssel für die Einlösecode-Hashes – nach dem ersten Start NICHT mehr ändern
# (sonst werden alle offenen Codes ungültig).
SECRET_KEY=

# Admins (Owner, fest): Minecraft-UUIDs, kommagetrennt (mit oder ohne Bindestriche).
# Vorgabe: das Minecraft-Konto PixelCST – es ist damit von Anfang an Admin. Weitere Konten mit Komma anhängen;
# eine UUID findest du im Cubiq Launcher unter Konten oder z. B. auf https://mcuuid.net.
ADMIN_UUIDS=93861992-3545-4c98-8760-4ef71e46c2ed

# Optional: Schlüssel für Admin-Skripte (Header X-Admin-Key), mindestens 32 Zeichen.
# Leer = nur Admin-Sitzungen. Erzeugen: openssl rand -hex 32
ADMIN_API_KEY=

# Pflicht: Adresse der Website, z. B. https://deine-domain.de (ohne / am Ende). Daraus ergeben sich die
# Adresse der API (gleiche App), die Doku (https://docs.deine-domain.de), die Microsoft-Rückleitung und die
# Absender der Mails. Für den lokalen Test setzt docker-compose.local.yml http://localhost:3000.
SITE_URL=
# Nur bei abweichendem Aufbau nötig (leer = Standard):
# Adresse der API für Umhang-URLs in Antworten (Standard: SITE_URL).
PUBLIC_BASE_URL=
# Zusätzliche Hosts, die nur die API bedienen (z. B. api.deine-domain.de); Seitenaufrufe dort → SITE_URL.
API_ONLY_HOSTS=
# Doku-Domain (Standard: https://docs.<Host von SITE_URL>, Tunnel-Hostname ohne Pfad).
WIKI_URL=

# Pflicht für Impressum (/imprint) und Datenschutzerklärung: wer die Website betreibt.
NUXT_PUBLIC_OPERATOR_NAME=
# Anschrift, mehrzeilig mit \n getrennt, z. B. Musterstraße 1\n12345 Musterstadt
NUXT_PUBLIC_OPERATOR_ADDRESS=
NUXT_PUBLIC_OPERATOR_EMAIL=
# Optional: Vertreten durch, Telefon, zuständige Datenschutz-Aufsichtsbehörde.
NUXT_PUBLIC_OPERATOR_REPRESENTATIVE=
NUXT_PUBLIC_OPERATOR_PHONE=
NUXT_PUBLIC_OPERATOR_AUTHORITY=

# Browser-Origins mit CORS-Zugriff, kommagetrennt, nur https (kein *).
# Launcher und Mod brauchen KEIN CORS – leer lassen, solange keine Webseite die API aufruft.
CORS_ORIGINS=

# Client-IP aus CF-Connecting-IP übernehmen (cloudflare) oder Socket-Adresse (none).
TRUST_PROXY=cloudflare

# Zugriffslog (Methode, Pfad, Status, Dauer – ohne IPs/Tokens).
LOG_REQUESTS=false

# Chat-Verschlüsselung (AES-256-GCM): "id:base64(32 Byte)", kommagetrennt, der ERSTE ist aktiv.
# Erzeugen: echo "k1:$(openssl rand -base64 32)". Leer = aus SECRET_KEY abgeleitet (Warnung im Log).
# Schlüsseltausch: neuen vorne eintragen, alten dahinter lassen (aus SECRET_KEY: "s1:derived"),
# neu starten, warten bis im Log "chat key rotation done" steht, erst dann den alten entfernen.
# Schlüssel NICHT verlieren (sonst sind die Chats unlesbar) und getrennt von DATA_DIR sichern.
CHAT_KEYS=

# Höchstens so viel Platz für Chat-Bilder insgesamt (MB). Danach 507 storage_full.
CHAT_STORAGE_MAX_MB=1024

# Server-Einladungen: Status (Icon, Spieler) vom Cubiq-Server abfragen (true) oder nicht (false).
SERVER_PING=true

# Welt-Hosting (API.md §21): gemeinsamer HMAC-Schlüssel mit deinem Relay-Server (relay/ im Launcher-Repo,
# dort in dessen .env derselbe Wert). Erzeugen: openssl rand -base64 48
# Schlüsseltausch: "NEU,ALT" (die API signiert mit dem ersten). Leer = Hosting aus.
RELAY_SECRET=
# Öffentlicher Name des Relays, z. B. relay.deine-domain.de (DNS-A-Record ohne Cloudflare-Proxy) + Ports.
RELAY_HOST=
RELAY_TCP_PORT=25503
RELAY_UDP_PORT=25504
# STUN-Server host:port (kommagetrennt). Leer = nur das Relay selbst.
HOSTING_STUN=

# Website-Anmeldung mit Microsoft (API.md §24.1) – vertraulicher Client der Azure-App (Plattform „Web“).
# Ohne ID + Secret ist die Anmeldung aus. Das Secret nie ins Repo.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Leer = <SITE_URL>/auth/microsoft/callback – genau so im Azure-Portal (Plattform „Web“) eintragen.
MS_REDIRECT_URI=

# Push für die Cubiq-Apps (API.md §33, UnifiedPush/Web Push). Schlüsselpaar erzeugen: node scripts/vapid-keys.mjs
# Alle drei setzen oder alle leer lassen (leer = UnifiedPush aus, iOS-Abruf geht trotzdem). Nie ins Repo.
# Den Schlüssel nicht tauschen, solange Geräte angemeldet sind (die Apps müssten sich neu anmelden).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Kontaktadresse für die Push-Dienste, z. B. mailto:du@deine-domain.de (nur zusammen mit den beiden Schlüsseln).
VAPID_SUBJECT=

# Empfohlene Modpacks (API.md §37): CurseForge-API-Schlüssel (https://console.curseforge.com). Leer = nur
# Modrinth-Links, CurseForge-Links → 503 curseforge_unavailable. Nie ins Repo.
CURSEFORGE_API_KEY=

# Mail + Newsletter (API.md §40). SMTP-Zugangsdaten NUR hier in der Server-.env – nie ins Repo, nie in Logs.
# SMTP_HOST leer = Mail aus (Versand → 503 mail_unavailable, Warnung beim Start; Entwürfe/Vorschau gehen trotzdem).
# Port 465 = SMTP_SECURE=true (TLS ab dem ersten Byte), Port 587 = SMTP_SECURE=false (STARTTLS ist dann Pflicht).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
# System-Konto (no-reply): Double-Opt-in-Bestätigungen, Team-Benachrichtigungen.
SMTP_USER=
SMTP_PASS=
# Absender; leer = Cubiq Launcher <no-reply@Host von SITE_URL>.
MAIL_FROM=
# Newsletter-Konto: Kampagnen + Testmails. Leer = alles über das System-Konto (Warnung beim Start).
NEWSLETTER_SMTP_USER=
NEWSLETTER_SMTP_PASS=
# Absender; leer = Cubiq Launcher <newsletter@Host von SITE_URL>.
NEWSLETTER_FROM=
# Optional: Antwort-Adresse aller Mails.
MAIL_REPLY_TO=
# Team-Benachrichtigungen an diese Adresse(n), wenn kein Team-Mitglied die Art eingeschaltet hat (kommagetrennt).
MAIL_TEAM_TO=
# Höchstens so viele Mails je Minute und Konto (Drosselung der Warteschlange).
MAIL_RATE_PER_MIN=60
